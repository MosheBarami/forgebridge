# Copy to `.env` and edit. `docker compose` reads `.env` from this directory
# automatically; `.env` itself is gitignored and `.env.example` is not.
#
# Only RELAY_DOMAIN has no usable default. Every other line here restates the
# default the relay would choose anyway, so that the whole configurable surface
# is visible in one file rather than spread across a table in a README.

# The hostname this relay serves. Caddy provisions a certificate for it.
# Use `localhost` to try the stack on your own machine: Caddy issues one from
# its own local CA, so `docker compose up` is a real end-to-end run rather than
# a special case that skips the proxy.
RELAY_DOMAIN=localhost

# Browser origins allowed to call the relay, comma-separated. Never `*`: these
# routes carry a bearer token. Empty means no browser origin is allowed, which
# is correct for a relay that only serves the Studio plugin and a CLI.
RELAY_ALLOWED_ORIGINS=

# Set this to close session minting to callers holding the operator's token.
# Leave it empty to let anyone mint one; it is rate limited either way and costs
# the relay a UUID and a pairing code.
RELAY_CONTROL_TOKEN=

# The published sponsored-run budget for a UTC day. It is reported on
# /v1/health before anyone hits it and quoted in the refusal when they do
# (ADR-010). A self-hosted relay with no run service wired grants none of these
# and says so; the number is still published, because the number is the promise.
RELAY_SPONSORED_DAILY_BUDGET=200

# Per-link ceilings, both below the protocol's own hard bounds (8 MiB and 500
# operations). The relay refuses to start if either is at or above them: a
# ceiling at the hard bound enforces nothing, and the typo that adds a zero
# turns the defence off without changing anything visible.
RELAY_MAX_CHANGESET_BYTES=1048576
RELAY_MAX_OPERATIONS=200

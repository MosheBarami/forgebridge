{
  "name": "@forgebridge/cli",
  "version": "0.1.0",
  "description": "The ForgeBridge command line. Headless use, CI, and every tool that does not speak MCP.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "bin": { "forgebridge": "./dist/bin.js" },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo 'lint: cli (configured in M04 follow-up)'"
  },
  "dependencies": {
    "@forgebridge/daemon": "*",
    "@forgebridge/luau-analysis": "*",
    "@forgebridge/protocol": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}

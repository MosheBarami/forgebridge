{
  "name": "@forgebridge/storage-sqlite",
  "version": "0.1.0",
  "description": "SQLite storage adapters: the daemon's store and the core's StoragePort, over node:sqlite. No account, no server, no native build step.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "lint": "echo 'lint: storage-sqlite (configured in M04 follow-up)'"
  },
  "dependencies": {
    "@forgebridge/core": "*",
    "@forgebridge/daemon": "*",
    "@forgebridge/protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}

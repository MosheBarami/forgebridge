{
  "name": "@forgebridge/opencloud",
  "version": "0.1.0",
  "description": "Roblox Open Cloud: publish place versions, read and write DataStore entries, publish MessagingService messages. No runtime dependencies; the API key is never persisted or logged.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "bin": { "forgebridge-opencloud": "./dist/bin.js" },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo 'lint: opencloud (configured in M04 follow-up)'"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}

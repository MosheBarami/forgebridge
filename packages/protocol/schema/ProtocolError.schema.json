{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProtocolError.schema.json",
  "title": "ProtocolError",
  "$comment": "Generated from packages/protocol/src by scripts/generate-schemas.ts. Do not edit.",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "#/$defs/ErrorCode"
    },
    "message": {
      "type": "string",
      "maxLength": 500
    },
    "remedy": {
      "type": "string",
      "maxLength": 500
    },
    "traceId": {
      "type": "string",
      "maxLength": 64
    }
  },
  "required": [
    "code",
    "message"
  ],
  "additionalProperties": true,
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "stale_base",
        "not_approved",
        "policy_violation",
        "link_unpaired",
        "link_unauthenticated",
        "replay_detected",
        "too_large",
        "rate_limited",
        "budget_exhausted",
        "provider_unconfigured",
        "unsupported_version",
        "not_found",
        "internal"
      ]
    }
  }
}
